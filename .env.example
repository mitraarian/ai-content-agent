# Documentation only: export variables in your shell; no automatic dotenv loader.
# No credentials or online services are required.
# FFmpeg/FFprobe and an already-installed browser are optional for slide rendering.
FFMPEG=ffmpeg
FFPROBE=ffprobe
# CONTENT_AGENT_BROWSER=   # Authorized local Chrome/Chromium executable
# PIPER_PYTHON=python      # Interpreter with optional piper-tts installed
# PIPER_MODEL=             # Authorized local ONNX model, downloaded separately
# LINKEDIN_SKILLS_DIR=     # Optional independent writing guidance checkout
# CONTENT_AGENT_NODE_MODULES= # Advanced: reuse an installed dependency tree for local testing
